# Доступы Timeweb. Файл должен лежать рядом со скриптом.
TIMEWEB_LOGIN="your_login"
TIMEWEB_PASSWORD="your_timeweb_password"
TIMEWEB_APPKEY="your_timeweb_app_key"

# DNS-резолверы, через которые проверяем появление TXT-записи.
DNS_RESOLVERS="1.1.1.1 8.8.8.8"

# Сколько секунд максимум ждать появления TXT у всех резолверов.
DNS_WAIT_TIMEOUT="300"

# Интервал между проверками.
DNS_WAIT_INTERVAL="10"

# Дополнительная пауза после того, как TXT уже виден через все DNS_RESOLVERS.
DNS_EXTRA_SLEEP_AFTER_VISIBLE="60"
